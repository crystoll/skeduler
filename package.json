{
  "name": "@crystoll/skeduler",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Schedule AI coding agents to start after a delay or at an exact local time. Supports Kiro, Copilot, Claude, Cursor, Aider, Goose, and Ollama.",
  "license": "MIT",
  "author": "Arto Santala",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/crystoll/skeduler.git"
  },
  "homepage": "https://github.com/crystoll/skeduler",
  "keywords": [
    "cli",
    "scheduler",
    "ai",
    "agent",
    "kiro",
    "copilot",
    "claude",
    "cursor",
    "aider",
    "goose",
    "ollama"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "skeduler": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/mark-executable.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm audit --prod"
  },
  "dependencies": {
    "commander": "15.0.0",
    "neverthrow": "8.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0-beta.1"
  },
  "packageManager": "pnpm@11.28.10"
}
